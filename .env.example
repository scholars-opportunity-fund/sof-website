NEXT_PUBLIC_SITE_URL=https://scholarsoppfund.com
# Analytics collector on the SOF Scholars platform. Defaults: http://localhost:3100/api/analytics/collect
# in development, https://scholars.scholarsoppfund.com/api/analytics/collect in production.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# Optional PostHog project key (phc_...). Unset = PostHog never loads, the site shows no
# analytics banner or Cookie settings link, the privacy notice leaves PostHog out, and /ingest
# returns 404. Set = the banner appears, and PostHog loads only after a visitor accepts it,
# through the same-origin /ingest relay. Inlined at build time, so a change needs a redeploy.
# NEXT_PUBLIC_POSTHOG_KEY=
